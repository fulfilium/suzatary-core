/// The world a Suzatary plugin targets: one function, `sync`, and one power, `fetch`.
///
/// The host links `fetch` for each plugin from its manifest. Of WASI it links the clocks, random
/// numbers, an empty environment, an empty standard input and a bounded standard error, and no
/// filesystem and no sockets, so a component that imports either is refused at load.
///
/// The version is the contract's. A change to any type below is a new version of the package,
/// and the host loads only the version it was built against.
package suzatary:plugin@0.4.0;

/// The one door to the network, held by the host.
///
/// The host sends a request only to an origin the manifest allows. A credential is named, never
/// held: its value is a URL, which the host reads and requests, so the plugin never learns it.
/// The host withholds an answer that contains a credential's value, and follows no redirect.
interface fetch {
    /// Where a request goes.
    variant target {
        /// A URL the plugin writes: `http` or `https`, a path and a query, no fragment, no
        /// userinfo.
        url(string),
        /// A credential the manifest declares, by name: its value is the URL.
        credential(string),
    }

    /// One answer, whatever its status.
    record response {
        status: u16,
        body: list<u8>,
    }

    /// Send one GET through the host. A refusal says why in the host's words: it names an
    /// origin or a credential, never a credential's value.
    fetch: func(target: target) -> result<response, string>;
}

/// What a source exports.
interface sync {
    /// What one call learned, and where the next call starts.
    record synced {
        /// Events of the schema the manifest names, each in the objects' literal grammar.
        items: list<list<u8>>,
        /// Opaque to the host, which keeps it and hands it back.
        cursor: list<u8>,
    }

    /// Read from `cursor`, or from the beginning when there is none, over the credentials the
    /// manifest declares, by name.
    ///
    /// Each call runs in a fresh instance, so the cursor is the only state that survives it.
    sync: func(cursor: option<list<u8>>, credentials: list<string>) -> result<synced, string>;
}

/// A plugin that reads the outside world: a calendar feed, a data provider.
world source {
    import fetch;
    export sync;
}
