#!/usr/bin/env bash
# Every tracked file a commit message names must be in the staged diff, or declared:
#
#     Mentions: scripts/safe-push.sh nix/services.nix
#
# A token names a file when it has a directory or a source extension and resolves to a tracked
# blob (a bare basename only if unique). Directories are never checked.
# Wired per clone with `git config core.hooksPath scripts/hooks`.
set -euo pipefail

msg_file="$1"
body=$(grep -v '^#' "$msg_file" || true)
subject=$(printf '%s\n' "$body" | grep -m1 . || true)
if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: the subject line is ${#subject} characters; git tooling truncates past 72" >&2
  exit 1
fi
if printf '%s\n' "$body" | grep -qiE 'claude\.ai/code/session|^Claude-Session:'; then
  echo "commit-msg: the message links a Claude session; the owner keeps sessions private, so drop the link or trailer" >&2
  exit 1
fi
mentions=$(printf '%s\n' "$body" | grep -iE '^Mentions:' | sed -E 's/^[Mm]entions:[[:space:]]*//' | tr ',' ' ' || true)
# The index, or COMMIT_MSG_COMMIT when scripts/check-commits.sh replays it (CI, so --no-verify
# cannot bypass it). A rename's old name may be named too.
if [ -n "${COMMIT_MSG_COMMIT:-}" ]; then
  staged=$(git diff-tree --no-commit-id -r --name-only -M --diff-filter=ACDMRT "$COMMIT_MSG_COMMIT")
  staged="$staged
$(git diff-tree --no-commit-id -r --name-status -M "$COMMIT_MSG_COMMIT" | awk '$1 ~ /^R/ {print $2}')"
else
  staged=$(git diff --cached --name-only -M --diff-filter=ACDMRT)
  staged="$staged
$(git diff --cached --name-status -M | awk '$1 ~ /^R/ {print $2}')"
fi

resolve() {
  local tok="$1"
  if git ls-files --error-unmatch -- "$tok" >/dev/null 2>&1 && ! git ls-files -- "$tok/" | grep -q .; then
    printf '%s\n' "$tok"; return
  fi
  case "$tok" in */*) return ;; esac
  local hits
  hits=$(git ls-files -- "*/$tok" "$tok")
  [ "$(printf '%s\n' "$hits" | grep -c .)" -eq 1 ] && printf '%s\n' "$hits"
}

missing=""
for tok in $(printf '%s\n' "$body" | grep -v -iE '^Mentions:' \
    | grep -oE '[A-Za-z0-9_./-]*[A-Za-z0-9_-]\.(py|sh|nix|md|typ|json|toml|lock|txt|yml)|[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]*[A-Za-z0-9_]' \
    | sed -E 's#^\./##' | sort -u); do
  path=$(resolve "$tok") || true
  [ -n "$path" ] || continue
  if ! printf '%s\n' "$staged" | grep -qxF -- "$path" \
     && ! printf '%s\n' "$mentions" | tr ' ' '\n' | grep -qxF -- "$path" \
     && ! printf '%s\n' "$mentions" | tr ' ' '\n' | grep -qxF -- "$tok"; then
    missing="$missing $path"
  fi
done

if [ -n "$missing" ]; then
  echo "commit-msg: the message names files the staged diff does not touch:$missing" >&2
  echo "  A commit message is a claim about a diff. Stage the change you described," >&2
  echo "  drop the claim, or declare a reference:  Mentions: <path> [<path> ...]" >&2
  exit 1
fi
